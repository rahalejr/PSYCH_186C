        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="task_kb_keys = trials.data['trial_kb.keys']&amp;#10;nogo_responses = []&amp;#10;&amp;#10;for i in range(num_trials):&amp;#10;    trial_type = trial_sequence[i]&amp;#10;    &amp;#10;    if trial_type:&amp;#10;        nogo_responses.append(task_kb_keys[i] != 'space')&amp;#10;        &amp;#10;        &amp;#10;correct_resp = sum(nogo_responses)&amp;#10;total_resp = len(nogo_responses)&amp;#10;percent_correct = int((correct_resp/total_resp)*100)&amp;#10;&amp;#10;feedback_string = f&quot;Correct: {correct_resp} \n Total: {total_resp} \n Percentage: {percent_correct}%&quot;&amp;#10;&amp;#10;thisExp.addData('correct_responses', correct_resp)&amp;#10;thisExp.addData('total_nogo_trials', total_resp)&amp;#10;        " valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
