      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# import random and seed with participant id&amp;#10;import random&amp;#10;random.seed(expInfo['participant'].lower())&amp;#10;&amp;#10;# Import stimuli_list&amp;#10;stimuli_list = data.importConditions('stimuli_list.xlsx')&amp;#10;&amp;#10;animal_images = list()&amp;#10;tool_images = list()&amp;#10;produce_images = list()&amp;#10;for item in stimuli_list:&amp;#10;    animal_images.append(item['Animal_Image_Files'])&amp;#10;    tool_images.append(item['Tool_Image_Files'])&amp;#10;    produce_images.append(item['Produce_Image_Files'])&amp;#10;&amp;#10;# Select three from each category to be encoded:&amp;#10;random.shuffle(animal_images)&amp;#10;random.shuffle(tool_images)&amp;#10;random.shuffle(produce_images)&amp;#10;phase_1_animals = animal_images[0:3]&amp;#10;phase_1_tools = tool_images[0:3]&amp;#10;phase_1_produce = produce_images[0:3]&amp;#10;&amp;#10;# Build the phase_1_sequence:&amp;#10;phase_1_sequence = list()&amp;#10;for im in phase_1_animals:&amp;#10;    phase_1_sequence.append(im)&amp;#10;for im in phase_1_tools:&amp;#10;    phase_1_sequence.append(im)&amp;#10;for im in phase_1_produce:&amp;#10;    phase_1_sequence.append(im)&amp;#10;random.shuffle(phase_1_sequence)&amp;#10;&amp;#10;# Build the phase_2_sequence:&amp;#10;phase_2_sequence = list()&amp;#10;for im in animal_images:&amp;#10;    phase_2_sequence.append(im)&amp;#10;for im in tool_images:&amp;#10;    phase_2_sequence.append(im)&amp;#10;for im in produce_images:&amp;#10;    phase_2_sequence.append(im)&amp;#10;random.shuffle(phase_2_sequence)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="&amp;#10;        // add-on: list(s: string): string[]&amp;#10;        function list(s) {&amp;#10;            // if s is a string, we return a list of its characters&amp;#10;            if (typeof s === 'string')&amp;#10;                return s.split('');&amp;#10;            else&amp;#10;                // otherwise we return s:&amp;#10;                return s;&amp;#10;        }&amp;#10;&amp;#10;        import * as random from 'random';&amp;#10;var animal_images, phase_1_animals, phase_1_produce, phase_1_sequence, phase_1_tools, phase_2_sequence, produce_images, stimuli_list, tool_images;&amp;#10;random.seed(expInfo[&quot;participant&quot;]);&amp;#10;stimuli_list = data.importConditions(&quot;stimuli_list.xlsx&quot;);&amp;#10;animal_images = list();&amp;#10;tool_images = list();&amp;#10;produce_images = list();&amp;#10;for (var item, _pj_c = 0, _pj_a = stimuli_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    item = _pj_a[_pj_c];&amp;#10;    animal_images.append(item[&quot;Animal_Image_Files&quot;]);&amp;#10;    tool_images.append(item[&quot;Tool_Image_Files&quot;]);&amp;#10;    produce_images.append(item[&quot;Produce_Image_Files&quot;]);&amp;#10;}&amp;#10;random.shuffle(animal_images);&amp;#10;random.shuffle(tool_images);&amp;#10;random.shuffle(produce_images);&amp;#10;phase_1_animals = animal_images.slice(0, 3);&amp;#10;phase_1_tools = tool_images.slice(0, 3);&amp;#10;phase_1_produce = produce_images.slice(0, 3);&amp;#10;phase_1_sequence = list();&amp;#10;for (var im, _pj_c = 0, _pj_a = phase_1_animals, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    im = _pj_a[_pj_c];&amp;#10;    phase_1_sequence.append(im);&amp;#10;}&amp;#10;for (var im, _pj_c = 0, _pj_a = phase_1_tools, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    im = _pj_a[_pj_c];&amp;#10;    phase_1_sequence.append(im);&amp;#10;}&amp;#10;for (var im, _pj_c = 0, _pj_a = phase_1_produce, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    im = _pj_a[_pj_c];&amp;#10;    phase_1_sequence.append(im);&amp;#10;}&amp;#10;random.shuffle(phase_1_sequence);&amp;#10;phase_2_sequence = list();&amp;#10;for (var im, _pj_c = 0, _pj_a = animal_images, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    im = _pj_a[_pj_c];&amp;#10;    phase_2_sequence.append(im);&amp;#10;}&amp;#10;for (var im, _pj_c = 0, _pj_a = tool_images, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    im = _pj_a[_pj_c];&amp;#10;    phase_2_sequence.append(im);&amp;#10;}&amp;#10;for (var im, _pj_c = 0, _pj_a = produce_images, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    im = _pj_a[_pj_c];&amp;#10;    phase_2_sequence.append(im);&amp;#10;}&amp;#10;random.shuffle(phase_2_sequence);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
